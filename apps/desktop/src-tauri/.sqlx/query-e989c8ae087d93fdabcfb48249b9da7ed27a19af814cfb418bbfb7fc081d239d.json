  "query": "SELECT\r\n    r.id,\r\n    r.title,\r\n    r.yield,\r\n    r.minutes,\r\n    r.img_url,\r\n    r.source,\r\n    r.color,\r\n    r.last_updated,\r\n    c.cloud_recipe_id,\r\n    CAST((\r\n        SELECT MAX(strftime('%Y-%m-%d %H:%M:%S', last_viewed))\r\n        FROM recipe_usage\r\n        WHERE recipe_id = r.id\r\n    ) AS TIMESTAMP) AS \"last_viewed: NaiveDateTime\"\r\nFROM recipes r\r\nLEFT JOIN (SELECT * FROM cloud_ids\r\n                WHERE username = $1) c\r\n    ON r.id = c.recipe_id\r\nWHERE r.last_updated > $2;\r\n",
